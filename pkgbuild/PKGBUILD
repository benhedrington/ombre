pkgname=gradgen
pkgver=0.1.0
pkgrel=1
pkgdesc='Generate gradient wallpapers from your Omarchy theme colours'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'python' 'python-numpy' 'python-pillow')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/gradgen "$pkgdir/usr/bin/gradgen"
  install -Dm644 backend/gradgen.py "$pkgdir/usr/share/gradgen/gradgen.py"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/gradgen.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/gradgen.svg"
  install -Dm644 "$startdir/gradgen.desktop" "$pkgdir/usr/share/applications/gradgen.desktop"
}
